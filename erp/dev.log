    SELECT DATE_TRUNC('day', "createdAt") AS bucket,
           COALESCE(SUM("totalAmount"), 0) AS revenue,
           COUNT(*)::bigint AS sale_count
    FROM sales
    WHERE "tenantId" = $1
      AND "status" = 'COMPLETED'
      AND "createdAt" >= $2
      AND "createdAt" <= $3
    GROUP BY DATE_TRUNC('day', "createdAt")
    ORDER BY bucket
  
