    SELECT
      pv."id",
      pv."sku",
      pv."form",
      pv."packSize",
      pv."stockQuantity",
      pv."lowStockThreshold",
      pv."productId",
      p."name" AS "productName"
    FROM "product_variants" pv
    JOIN "products" p ON pv."productId" = p."id"
    WHERE pv."tenantId" = $1
      AND pv."deletedAt" IS NULL
      AND p."isArchived" = false
