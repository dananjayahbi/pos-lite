prisma:query 
        SELECT
          c."id" AS "categoryId",
          c."name" AS "categoryName",
          COALESCE(SUM(rl."lineRefundAmount"), 0) AS "totalRefunds"
        FROM "return_lines" rl
        JOIN "returns" r ON r."id" = rl."returnId"
        JOIN "product_variants" pv ON pv."id" = rl."variantId"
        JOIN "products" p ON p."id" = pv."productId"
        JOIN "categories" c ON c."id" = p."categoryId"
        WHERE r."tenantId" = $1
          AND r."status" = 'COMPLETED'
          AND r."createdAt" >= $2
          AND r."createdAt" <= $3
        GROUP BY c."id", c."name"
        ORDER BY "totalRefunds" DESC
      
prisma:query SELECT COUNT(*) AS "_count$_all", SUM("public"."returns"."refundAmount") AS "_sum$refundAmount", "public"."returns"."reason" FROM "public"."returns" WHERE ("public"."returns"."tenantId" = $1 AND "public"."returns"."status" = CAST($2::text AS "public"."ReturnStatus") AND "public"."returns"."createdAt" >= $3 AND "public"."returns"."createdAt" <= $4) GROUP BY "public"."returns"."reason" OFFSET $5
prisma:query 
        SELECT
          c."id" AS "categoryId",
          c."name" AS "categoryName",
          COALESCE(SUM(sl."lineTotalAfterDiscount"), 0) AS "totalSales"
        FROM "sale_lines" sl
        JOIN "sales" s ON s."id" = sl."saleId"
        JOIN "product_variants" pv ON pv."id" = sl."variantId"
        JOIN "products" p ON p."id" = pv."productId"
        JOIN "categories" c ON c."id" = p."categoryId"
        WHERE s."tenantId" = $1
          AND s."status" = 'COMPLETED'
          AND s."createdAt" >= $2
          AND s."createdAt" <= $3
        GROUP BY c."id", c."name"
        ORDER BY "totalSales" DESC
      
prisma:query 
        SELECT
          p."name" AS "productName",
          SUM(rl."quantity") AS "unitsReturned",
          SUM(rl."lineRefundAmount") AS "returnValue"
        FROM "return_lines" rl
        JOIN "returns" r ON r."id" = rl."returnId"
        JOIN "product_variants" pv ON pv."id" = rl."variantId"
        JOIN "products" p ON p."id" = pv."productId"
        WHERE r."tenantId" = $1
          AND r."status" = 'COMPLETED'
          AND r."createdAt" >= $2
          AND r."createdAt" <= $3
        GROUP BY p."id", p."name"
        ORDER BY "unitsReturned" DESC
        LIMIT 10
      
