# ─────────────────────────────────────────────────────────────────────────────
# ERP (admin) — environment template
#
# Copy to `.env.local` and fill in every value. `.env.local` is git-ignored.
# Never commit a real secret; the values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ayurpos"
AUTH_SECRET="generate-with: pnpm dlx auth secret"
# Canonical URL of THIS app (the ERP/admin). Used for auth callbacks and for
# PayHere's server-to-server `notify_url`.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AyurPOS"

# ── Storefront (customer website) ────────────────────────────────────────────
# Origin of the customer-facing website. PayHere's `return_url` and
# `cancel_url` redirect the customer's BROWSER here, so this must be the
# storefront, NOT this app.
WEBSITE_URL="http://localhost:3002"
# Shared secret for on-demand ISR revalidation (must match the website's).
REVALIDATION_SECRET="change-me"

# ── PayHere payment gateway ──────────────────────────────────────────────────
# Merchant Portal: https://www.payhere.lk/merchant/
# Sandbox Portal:  https://sandbox.payhere.lk/merchant/
#
# "true" routes every URL to sandbox.payhere.lk. Anything else = live.
PAYHERE_SANDBOX="true"
# Merchant ID — same for sandbox and live. Side Menu > Integrations.
PAYHERE_MERCHANT_ID=""
# Merchant Secret — specific to a registered DOMAIN/APP (not the account).
# Required for BOTH signatures: the checkout `hash` we send and the IPN
# `md5sig` we verify. Unset => card checkout cannot complete and every IPN is
# rejected with SECRET_NOT_CONFIGURED (visible in GET /api/health).
PAYHERE_MERCHANT_SECRET=""
# REST API credentials (retrieval/refund/charging). Optional until used.
PAYHERE_APP_ID=""
PAYHERE_APP_SECRET=""

# ── Notifications ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@example.com"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_TEMPLATE_NAME=""

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="supabase" # supabase | cloudinary | r2
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Misc ─────────────────────────────────────────────────────────────────────
CRON_SECRET="change-me"
RATE_LIMIT_DB=""
