  attemptedAt       DateTime              @default(now())

  @@index([webhookEndpointId])
  @@map("webhook_deliveries")
}

// ── Customer-Facing Website Models ───────────────────────────────────────────

model WebsiteConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Branding
  siteName   String?
  tagline    String?
  logoUrl    String?
  faviconUrl String?

  // Colors
  primaryColor String? @default("#0a0a0a")
  accentColor  String? @default("#b4946e")
  bgColor      String? @default("#ece2d6")

  // Typography
  headingFontFamily String?
  bodyFontFamily    String?
  headingColor      String? @default("#0a0a0a")
  bodyColor         String? @default("#555555")

  // SEO
  metaTitle       String?
  metaDescription String?

  // Social Links — { facebook, instagram, email, phone, whatsapp }
  socialLinks Json @default("{}")

  // Navigation menu items — [{ label, href, children? }]
  navItems Json @default("[]")

  // Section-level configuration stored as JSON keyed by sectionKey
  // Each key maps to: { isActive, sortOrder, ...sectionSpecificFields }
  // sectionKeys:
  //   hero, imageSlider, bestSelling, infoAd, categories,
  //   latestProducts, testimonials, storeReference, footer
  sections Json @default("{}")

  // Footer
  footerAbout   String? @db.Text
  footerColumns Json    @default("[]")

  // About Page
  aboutPageTitle          String?
  aboutPageSubtitle       String?
  aboutHeroImageUrl       String?
  aboutStoryTitle         String?
  aboutStoryContent       String? @db.Text
  aboutStoryImageUrl      String?
  aboutMissionTitle       String?
  aboutMissionContent     String? @db.Text
  aboutValuesSectionTitle String?
  aboutValues             Json    @default("[]")

  // Contact Page
  contactPageTitle     String?
  contactPageSubtitle  String?
  contactHeroImageUrl  String?
  contactInfoTitle     String?
  contactAddress       String?
  contactPhoneDisplay  String?
  contactEmailDisplay  String?
  contactBusinessHours String? @db.Text
  contactMapEmbedUrl   String?

  // Shop Page
  shopPageTitle       String?
  shopPageSubtitle    String?
  shopHeroImageUrl    String?
  shopPageDescription String?
  shopProductsPerPage Int?    @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroSlides WebsiteHeroSlide[]
  ads        WebsiteAd[]

  @@map("website_configs")
}

model WebsiteHeroSlide {
  id       String        @id @default(cuid())
  tenantId String
  configId String
  config   WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  mediaType      String  @default("image") // "image" | "video"
  mediaUrl       String
  mobileMediaUrl String? // optional mobile-optimized variant

  title       String?
  subtitle    String?
  description String?

  ctaText String?
  ctaLink String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@index([tenantId])
  @@map("website_hero_slides")
}

model WebsiteAd {
  id       String        @id @default(cuid())
  tenantId String
  configId String
  config   WebsiteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  name           String
  mediaType      String  @default("image") // "image" | "video"
  mediaUrl       String
  mobileMediaUrl String?

  targetUrl String?

  // position: "header" | "between_sections" | "sidebar" | "popup"
  position            String  @default("between_sections")
  // sectionKey to display after (e.g. "latestProducts"); only used when position = "between_sections"
  displayAfterSection String?

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@index([tenantId])
  @@map("website_ads")
}

// ── Appointments Models ──────────────────────────────────────────────────────

model AppointmentService {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  durationMins Int
  price        Decimal   @db.Decimal(10, 2)
  color        String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("appointment_services")
}

model AppointmentSlot {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  staffId       String
  staff         User         @relation("AppointmentSlotStaff", fields: [staffId], references: [id])
  date          DateTime     @db.Date
  startTime     DateTime
  endTime       DateTime
  isBooked      Boolean      @default(false)
  isBlocked     Boolean      @default(false)
  appointmentId String?      @unique
  appointment   Appointment? @relation
  createdAt     DateTime     @default(now())

  @@unique([staffId, date, startTime])
  @@index([tenantId, date])
  @@index([staffId, date])
  @@map("appointment_slots")
}

model Appointment {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  customerId String?
  customer   Customer?           @relation(fields: [customerId], references: [id])
  serviceId  String?
  service    AppointmentService? @relation(fields: [serviceId], references: [id])
  staffId    String?
  staff      User?               @relation("AppointmentStaff", fields: [staffId], references: [id])
  slotId     String?             @unique
  slot       AppointmentSlot?    @relation(fields: [slotId], references: [id])

  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  durationMins Int
  status       AppointmentStatus @default(SCHEDULED)

  price         Decimal  @db.Decimal(10, 2)
  depositAmount Decimal? @default(0) @db.Decimal(10, 2)
  isPaid        Boolean  @default(false)

  walkInName  String?
  walkInPhone String?

  notes              String?
  customerNotes      String?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?     @relation("AppointmentCanceller", fields: [cancelledById], references: [id])

  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation("AppointmentCheckIn", fields: [checkedInById], references: [id])
  completedAt   DateTime?

  recurrenceType      AppointmentRecurrenceType?
  recurrenceEndDate   DateTime?
  parentAppointmentId String?
  parentAppointment   Appointment?               @relation("RecurringAppointments", fields: [parentAppointmentId], references: [id])
  childAppointments   Appointment[]              @relation("RecurringAppointments")

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdById String
  createdBy   User     @relation("AppointmentCreator", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  reminders AppointmentReminder[]

  @@index([tenantId, startTime])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@index([tenantId, startTime, status])
  @@map("appointments")
}

model AppointmentReminder {
  id            String                     @id @default(cuid())
  appointmentId String
  appointment   Appointment                @relation(fields: [appointmentId], references: [id])
  tenantId      String
  tenant        Tenant                     @relation(fields: [tenantId], references: [id])
  scheduledFor  DateTime
  sentAt        DateTime?
  channel       AppointmentReminderChannel
  status        AppointmentReminderStatus  @default(PENDING)
  errorMessage  String?
  createdAt     DateTime                   @default(now())

  @@index([appointmentId])
  @@index([tenantId, status])
  @@map("appointment_reminders")
}

model StaffAvailability {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  staffId          String
  staff            User    @relation("StaffAvailabilityUser", fields: [staffId], references: [id])
  dayOfWeek        Int
  startTime        String
  endTime          String
  isAvailable      Boolean @default(true)
  slotDurationMins Int     @default(15)

  @@unique([staffId, dayOfWeek])
  @@index([tenantId])
  @@map("staff_availability")
}

model StaffTimeOff {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  staffId      String
  staff        User      @relation("StaffTimeOffUser", fields: [staffId], references: [id])
  date         DateTime  @db.Date
  startTime    DateTime?
  endTime      DateTime?
  reason       String?
  isApproved   Boolean   @default(false)
  approvedById String?
  approvedBy   User?     @relation("StaffTimeOffApprover", fields: [approvedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([staffId, date])
  @@index([tenantId])
  @@map("staff_time_offs")
}

// ── Delivery / Courier Models ─────────────────────────────────────────────────

model ShippingAddress {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  fullName     String
  phone        String
  phone2       String?
  addressLine1 String
  addressLine2 String?
  districtId   Int?
  districtName String?
  cityId       Int?
  cityName     String
  postalCode   String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deliveries Delivery[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("shipping_addresses")
}

model Delivery {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  source          DeliverySource   @default(ERP_MANUAL)
  status          DeliveryStatus   @default(PLACED)
  saleId          String?
  sale            Sale?            @relation(fields: [saleId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  addressId       String?          @unique
  address         ShippingAddress? @relation(fields: [addressId], references: [id])
  orderRef        String
  courierOrderRef String?
  codAmount       Decimal          @default(0) @db.Decimal(12, 2)
  declaredValue   Decimal?         @db.Decimal(12, 2)
  itemCount       Int              @default(1)
  totalWeightKg   Decimal?         @db.Decimal(6, 2)
  hubWeightKg     Decimal?         @db.Decimal(6, 2)
  shippingFee     Decimal?         @db.Decimal(12, 2)
  deliveryFee     Decimal?         @db.Decimal(12, 2)
  statusPipeline  Json?
  holdExpiresAt   DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  canceledAt      DateTime?
  canceledById    String?
  canceledBy      User?            @relation("DeliveryCanceller", fields: [canceledById], references: [id])
  failureReason   String?
  notes           String?
  assignedStaffId String?
  assignedStaff   User?            @relation("DeliveryAssignedStaff", fields: [assignedStaffId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  shipments             CourierShipment[]
  events                DeliveryEvent[]
  attempts              DeliveryRecovery[]
  packages              Package[]
  packagingConsumptions PackagingConsumption[]
  reconciliationEntry   ReconciliationLedgerEntry?

  @@index([tenantId, status])
  @@index([tenantId, dispatchedAt])
  @@index([tenantId, orderRef])
  @@index([tenantId, customerId])
  @@map("deliveries")
}

model CourierShipment {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  deliveryId          String          @unique
  delivery            Delivery        @relation(fields: [deliveryId], references: [id])
  provider            CarrierProvider @default(TRANSEXPRESS)
  env                 CourierEnv      @default(STAGING)
  waybillId           String
  waybillMode         WaybillMode     @default(AUTO)
  status              ShipmentStatus  @default(SUBMITTED)
  rawStatus           String?
  courierOrderId      String?
  carrierLastSyncedAt DateTime?
  lastRawResponse     Json?
  latestEventAt       DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  events DeliveryEvent[]

  @@unique([tenantId, waybillId])
  @@index([tenantId, status])
  @@index([provider])
  @@map("courier_shipments")
}

model DeliveryEvent {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  deliveryId    String
  delivery      Delivery         @relation(fields: [deliveryId], references: [id])
  shipmentId    String?
  shipment      CourierShipment? @relation(fields: [shipmentId], references: [id])
  status        DeliveryStatus
  carrierStatus ShipmentStatus?
  rawStatusName String?
  remarks       String?
  eventAt       DateTime         @default(now())
  source        String           @default("INTERNAL")
  createdById   String?
  createdAt     DateTime         @default(now())

  @@index([deliveryId, eventAt])
  @@index([tenantId])
  @@map("delivery_events")
}

model Package {
  id         String                @id @default(cuid())
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  deliveryId String
  delivery   Delivery              @relation(fields: [deliveryId], references: [id])
  status     DeliveryPackageStatus @default(AWAITING_WEIGH)
  weightKg   Decimal?              @db.Decimal(6, 2)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([tenantId])
  @@index([deliveryId])
  @@map("packages")
}

model CourierAccount {
  id                String          @id @default(cuid())
  tenantId          String          @unique
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  provider          CarrierProvider @default(TRANSEXPRESS)
  env               CourierEnv      @default(STAGING)
  email             String?
  password          String?
  apiKey            String?
  originDistrictId  Int?
  originCityId      Int?
  pickupAddress     String?
  isActive          Boolean         @default(false)
  lastTokenIssuedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([provider])
  @@map("courier_accounts")
}

model RateCard {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  isActive          Boolean  @default(true)
  baseRate          Decimal  @default(0) @db.Decimal(12, 2)
  extraKgRate       Decimal  @default(0) @db.Decimal(12, 2)
  freeBaseWeightKg  Decimal  @default(1) @db.Decimal(6, 2)
  coddCommissionPct Decimal? @db.Decimal(5, 2)
  vatRatePct        Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries RateCardEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("rate_cards")
}

model RateCardEntry {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  rateCardId            String
  rateCard              RateCard @relation(fields: [rateCardId], references: [id])
  originDistrictId      Int?
  destinationDistrictId Int?
  destinationCityId     Int?
  baseRate              Decimal? @db.Decimal(12, 2)
  extraKgRate           Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([rateCardId])
  @@map("rate_card_entries")
}

model PackagingItem {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  category             PackagingCategory
  name                 String
  sku                  String?
  unit                 PackagingUnit     @default(PIECE)
  quantityOnHand       Int               @default(0)
  lowStockThreshold    Int               @default(0)
  autoDeduct           Boolean           @default(false)
  consumptionPerParcel Decimal?          @db.Decimal(6, 2)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  consumptions PackagingConsumption[]

  @@index([tenantId, category])
  @@map("packaging_items")
}

model PackagingConsumption {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  deliveryId      String
  delivery        Delivery      @relation(fields: [deliveryId], references: [id])
  packagingItemId String
  packagingItem   PackagingItem @relation(fields: [packagingItemId], references: [id])
  quantity        Decimal       @db.Decimal(6, 2)
  createdAt       DateTime      @default(now())

  @@index([tenantId])
  @@index([deliveryId])
  @@map("packaging_consumptions")
}

model DeliveryRecovery {
  id                   String         @id @default(cuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  deliveryId           String
  delivery             Delivery       @relation(fields: [deliveryId], references: [id])
  action               RecoveryAction
  staffId              String
  staff                User           @relation("RecoveryStaff", fields: [staffId], references: [id])
  notes                String?
  redeliveryShipmentId String?
  createdAt            DateTime       @default(now())

  @@index([tenantId])
  @@index([deliveryId])
  @@map("delivery_recoveries")
}

model ReconciliationLedgerEntry {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  deliveryId        String               @unique
  delivery          Delivery             @relation(fields: [deliveryId], references: [id])
  waybillId         String?
  expectedCod       Decimal              @default(0) @db.Decimal(12, 2)
  status            ReconciliationStatus @default(PENDING_SETTLEMENT)
  expectedFee       Decimal?             @db.Decimal(12, 2)
  settledAmount     Decimal?             @db.Decimal(12, 2)
  settledAt         DateTime?
  statementImportId String?
  statementImport   StatementImport?     @relation(fields: [statementImportId], references: [id])
  discrepancyNote   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([waybillId])
  @@index([tenantId, deliveryId])
  @@map("reconciliation_ledger_entries")
}

model StatementImport {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  provider         CarrierProvider       @default(TRANSEXPRESS)
  filename         String
  uploadedById     String
  uploadedBy       User                  @relation("StatementImportUploader", fields: [uploadedById], references: [id])
  status           StatementImportStatus @default(UPLOADED)
  rowCount         Int                   @default(0)
  matchedCount     Int                   @default(0)
  discrepancyCount Int                   @default(0)
  rawRows          Json?
  parseError       String?
  uploadedAt       DateTime              @default(now())
  completedAt      DateTime?

  ledgerEntries ReconciliationLedgerEntry[]

  @@index([tenantId, uploadedAt])
  @@map("statement_imports")
}
