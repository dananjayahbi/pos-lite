# ─────────────────────────────────────────────────────────────────────────────
# Website (customer storefront) — environment template
#
# Copy to `.env.local` and fill in every value. `.env.local` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the ERP backend that serves this storefront's public API.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3003"

# Tenant shown when a visitor hits the bare host (no /[tenantSlug] segment).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG="ruhunuwedagedara"

# Public origin of THIS storefront (used for SEO metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# ISR revalidation interval, seconds.
NEXT_PUBLIC_REVALIDATE_SECONDS="60"

# Shared secret for the /api/revalidate endpoint (must match the ERP's
# REVALIDATION_SECRET).
REVALIDATION_SECRET="change-me"

# ── PayHere payment gateway ──────────────────────────────────────────────────
# The merchant secret NEVER belongs here — it lives only in the ERP, which
# computes the checkout `hash` server-side. This flag only controls whether the
# "Pay by Card" option is offered, so a storefront pointed at an ERP without
# PayHere credentials does not advertise a payment method that cannot complete.
NEXT_PUBLIC_PAYHERE_ENABLED="true"
