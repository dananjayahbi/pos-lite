# ─────────────────────────────────────────────────────────────────────────────
# Ruhunuwedagedara Website — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and adjust the values for your setup.

# The base URL of the ERP backend API.
#   • Local dev  (admin on port 3003): http://admin.ruhunuwedagedara.lk:3003
#     (requires the /etc/hosts entries:  ruhunuwedagedara.lk + admin.ruhunuwedagedara.lk)
#   • Production (same VPS, behind reverse proxy): https://admin.ruhunuwedagedara.lk
NEXT_PUBLIC_API_BASE_URL=http://admin.ruhunuwedagedara.lk:3003

# Default tenant slug loaded when a visitor hits the bare host
# (e.g. http://ruhunuwedagedara.lk:3002/ renders this tenant's storefront).
# Must match an existing tenant in the ERP — the seed script creates `dilani`.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=dilani

# Public site URL — used for SEO metadata, OG tags, canonical URLs.
NEXT_PUBLIC_SITE_URL=http://ruhunuwedagedara.lk:3002

# Revalidation interval for ISR (in seconds). 0 = always dynamic.
NEXT_PUBLIC_REVALIDATE_SECONDS=60